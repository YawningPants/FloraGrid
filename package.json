{
  "name": "desktop-calendar-tauri",
  "version": "1.0.0",
  "description": "日枝 FloraGrid：支持树状任务、跨日期复制、长期任务、公农历提醒与本地存储的桌面日程工具。",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/drag-browser.mjs",
    "test:tags": "node tests/tags-browser.mjs",
    "test:settings": "node tests/settings-browser.mjs",
    "test:calendar": "node tests/calendar-browser.mjs",
    "test:botanical": "node tests/botanical-browser.mjs",
    "test:garden": "node tests/header-garden-browser.mjs",
    "test:release-features": "node tests/release-features-browser.mjs",
    "test:paper-polish": "node tests/paper-polish-browser.mjs",
    "test:growth-refinements": "node tests/growth-refinements-browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node tools/screenshots/capture.mjs",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release/windows.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  }
}
