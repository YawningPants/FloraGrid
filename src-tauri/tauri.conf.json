{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面日历",
  "version": "1.0.0",
  "identifier": "com.example.desktop-calendar",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "桌面日历",
        "width": 390,
        "height": 900,
        "minWidth": 320,
        "minHeight": 640,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
