{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "日枝",
  "version": "1.0.0",
  "identifier": "com.example.desktop-calendar",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "日枝 · 日视图",
        "width": 390,
        "height": 900,
        "minWidth": 320,
        "minHeight": 640,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "maximizable": false,
        "backgroundColor": "#00000000"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "YawningPants",
    "category": "Productivity",
    "shortDescription": "本地桌面日程与树状任务",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
