{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the desktop calendar window.",
  "windows": ["main", "tag-manager"],
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "dialog:allow-open",
    "core:default"
  ]
}
